<?xml version="1.0" encoding="utf-8"?>
<Mod id="9d0478e8-0490-4a83-a529-ef103f46e734" version="1">
  <Properties>
    <Name>LOC_SA_MOD_NAME</Name>
    <Teaser>LOC_SA_MOD_TEASER</Teaser>
    <Description>LOC_SA_MOD_DESCRIPTION</Description>
    <Authors>Settlements Advisor</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>

  <Dependencies>
    <Mod id="4ecfcc62-5471-4435-b295-590df213e8d8" title="Detailed Map Tacks"/>
  </Dependencies>

  <!-- Shown in the mod list even while the mod is disabled (its text files are not loaded yet). -->
  <LocalizedText>
    <Text id="LOC_SA_MOD_NAME">
      <en_US>Settlements Advisor</en_US>
      <ru_RU>Советник по городам</ru_RU>
    </Text>
    <Text id="LOC_SA_MOD_TEASER">
      <en_US>Select a Settler and see the best city sites, their district layouts and why.</en_US>
      <ru_RU>Выделите Поселенца — и сразу видно лучшие места для города, раскладку районов и почему.</ru_RU>
    </Text>
    <Text id="LOC_SA_MOD_DESCRIPTION">
      <en_US>When a Settler is selected, the map is colored by how good each city site is, the three best sites nearby are numbered, and the best district layout is previewed around the site under the cursor. The plot tooltip explains every number. Uses only what the player can see. Gathering Storm only. Requires Detailed Map Tacks.</en_US>
      <ru_RU>При выделении Поселенца карта окрашивается по качеству мест для города, три лучших места рядом получают номера, а вокруг места под курсором показана лучшая раскладка районов. Подсказка клетки объясняет каждое число. Использует только то, что видит игрок. Только Gathering Storm. Нужен Detailed Map Tacks.</ru_RU>
    </Text>
  </LocalizedText>

  <ActionCriteria>
    <Criteria id="SA_GatheringStorm">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
    </Criteria>
  </ActionCriteria>

  <FrontEndActions>
    <UpdateText id="sa_frontend_text">
      <File>Text/SA_Text_en_US.xml</File>
      <File>Text/SA_Text_ru_RU.xml</File>
    </UpdateText>
  </FrontEndActions>

  <InGameActions>
    <UpdateColors id="sa_colors">
      <File>Config/SA_Colors.xml</File>
    </UpdateColors>
    <UpdateText id="sa_text">
      <File>Text/SA_Text_en_US.xml</File>
      <File>Text/SA_Text_ru_RU.xml</File>
    </UpdateText>
    <ImportFiles id="sa_scripts">
      <Properties>
        <LoadOrder>15000</LoadOrder>
      </Properties>
      <File>Scripts/SA_World.lua</File>
      <File>Scripts/SA_Rules.lua</File>
      <File>Scripts/SA_Scheduler.lua</File>
      <File>Scripts/SA_Candidates.lua</File>
      <File>Scripts/SA_Prior.lua</File>
      <File>Scripts/SA_Tiles.lua</File>
      <File>Scripts/SA_Score.lua</File>
      <File>Scripts/SA_Coarse.lua</File>
      <File>Scripts/SA_Rank.lua</File>
      <File>Scripts/SA_Explain.lua</File>
      <File>Scripts/SA_DMT.lua</File>
      <File>Scripts/SA_Layout.lua</File>
      <File>Scripts/SA_Pins.lua</File>
      <File>Scripts/SA_Empire.lua</File>
      <File>Scripts/SA_Growth.lua</File>
      <File>Scripts/SA_Strategy.lua</File>
      <File>Scripts/SA_Specialize.lua</File>
    </ImportFiles>
    <AddUserInterfaces id="sa_main">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>15000</LoadOrder>
      </Properties>
      <File>UI/SA_Main.xml</File>
    </AddUserInterfaces>
    <!-- Only with Gathering Storm: the replacement builds on PlotToolTip_Expansion2. -->
    <ReplaceUIScript id="sa_plottooltip" criteria="SA_GatheringStorm">
      <Properties>
        <LoadOrder>15000</LoadOrder>
        <LuaContext>PlotToolTip</LuaContext>
        <LuaReplace>UI/SA_PlotToolTip.lua</LuaReplace>
      </Properties>
    </ReplaceUIScript>
  </InGameActions>

  <Files>
    <File>Text/SA_Text_en_US.xml</File>
    <File>Text/SA_Text_ru_RU.xml</File>
    <File>Config/SA_Colors.xml</File>
    <File>Scripts/SA_World.lua</File>
    <File>Scripts/SA_Rules.lua</File>
    <File>Scripts/SA_Scheduler.lua</File>
    <File>Scripts/SA_Candidates.lua</File>
    <File>Scripts/SA_Prior.lua</File>
    <File>Scripts/SA_Tiles.lua</File>
    <File>Scripts/SA_Score.lua</File>
    <File>Scripts/SA_Coarse.lua</File>
    <File>Scripts/SA_Rank.lua</File>
    <File>Scripts/SA_Explain.lua</File>
    <File>Scripts/SA_DMT.lua</File>
    <File>Scripts/SA_Layout.lua</File>
    <File>Scripts/SA_Pins.lua</File>
    <File>Scripts/SA_Empire.lua</File>
    <File>Scripts/SA_Growth.lua</File>
    <File>Scripts/SA_Strategy.lua</File>
    <File>Scripts/SA_Specialize.lua</File>
    <File>UI/SA_Main.xml</File>
    <File>UI/SA_Main.lua</File>
    <File>UI/SA_PlotToolTip.lua</File>
  </Files>
</Mod>
